@model List<Tienda.Web.Models.ProductoCardViewModel>
@using Tienda.Web.Util
@{
    var categoria = (Tienda.Application.DTOs.CategoriaDTO)ViewBag.Categoria;
    ViewData["Title"] = categoria.Categoria1;
}
@section Styles {
    <link rel="stylesheet" href="~/css/styleProductos.css" asp-append-version="true" />
}

<nav class="migas" aria-label="Ruta">
    <a asp-controller="Home" asp-action="Index">Inicio</a><i class="bi bi-chevron-right"></i>
    <a asp-controller="Producto" asp-action="Index">Productos</a><i class="bi bi-chevron-right"></i>
    <span>@categoria.Categoria1</span>
</nav>

<header class="cabecera-categoria">
    @if (categoria.Foto != null)
    {
        <img src="@Formato.Base64(categoria.Foto)" alt="" />
    }
    <div>
        <span class="antetitulo">Categoría</span>
        <h1>@categoria.Categoria1</h1>
        <p>@Model.Count @(Model.Count == 1 ? "producto disponible" : "productos disponibles")</p>
    </div>
</header>

@if (Model.Any())
{
    <div class="productos-grid">
        @foreach (var tarjeta in Model)
        {
            <partial name="_ProductoCard" model="tarjeta" />
        }
    </div>
}
else
{
    <div class="vacio"><i class="bi bi-box-seam"></i>Esta categoría todavía no tiene productos.</div>
}
