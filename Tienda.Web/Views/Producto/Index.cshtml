@model List<Tienda.Web.Models.ProductoCardViewModel>
@{
    ViewData["Title"] = "Productos";
    var categorias = ViewBag.Categorias as List<Tienda.Application.DTOs.CategoriaDTO> ?? new();
    var enOferta = Model.Count(m => m.Oferta != null);
}
@section Styles {
    <link rel="stylesheet" href="~/css/styleProductos.css" asp-append-version="true" />
}

<header class="encabezado">
    <div>
        <span class="antetitulo">Catálogo</span>
        <h1>Productos</h1>
        <p>Videojuegos, consolas y accesorios. Filtra por categoría, busca por nombre u ordena por precio.</p>
    </div>
    <div class="resumen-catalogo">
        <span><strong>@Model.Count</strong> productos</span>
        @if (enOferta > 0)
        {
            <span><strong>@enOferta</strong> en oferta</span>
        }
    </div>
</header>

<section class="filtros panel" aria-label="Filtros del catálogo">
    <div class="filtros-busqueda">
        <i class="bi bi-search"></i>
        <input type="search" class="form-control" id="buscarProducto" placeholder="Buscar por nombre…" autocomplete="off" aria-label="Buscar producto" />
    </div>
    <div class="filtros-categorias" role="group" aria-label="Categorías">
        <button type="button" class="filtro activo" data-filtro-categoria="">Todas</button>
        @foreach (var categoria in categorias)
        {
            <button type="button" class="filtro" data-filtro-categoria="@categoria.IdCategoria">@categoria.Categoria1</button>
        }
    </div>
    <div class="filtros-extra">
        <label class="form-check form-switch m-0">
            <input class="form-check-input" type="checkbox" id="soloOfertas" />
            <span class="form-check-label">Solo ofertas</span>
        </label>
        <select class="form-select form-select-sm" id="ordenarProductos" aria-label="Ordenar productos">
            <option value="nombre">Nombre (A–Z)</option>
            <option value="precio-asc">Precio: menor a mayor</option>
            <option value="precio-desc">Precio: mayor a menor</option>
        </select>
    </div>
</section>

@if (Model.Any())
{
    <div class="productos-grid" id="gridProductos">
        @foreach (var tarjeta in Model)
        {
            <partial name="_ProductoCard" model="tarjeta" />
        }
    </div>
    <div class="vacio" id="sinResultados" hidden>
        <i class="bi bi-search"></i>
        No encontramos productos con esos filtros.
    </div>
}
else
{
    <div class="vacio"><i class="bi bi-box-seam"></i>Todavía no hay productos registrados.</div>
}

@section Scripts {
    <script src="~/js/app.js" asp-append-version="true"></script>
}
