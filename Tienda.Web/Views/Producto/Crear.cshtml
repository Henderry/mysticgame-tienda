@model Tienda.Application.DTOs.ProductoDTO
@using Tienda.Web.Util
@{
    ViewData["Title"] = "Administrar productos";
    ViewData["CampoEtiquetas"] = "selectedEtiqueta";
    var productos = (ViewBag.Productos as IEnumerable<Tienda.Application.DTOs.ProductoDTO> ?? Enumerable.Empty<Tienda.Application.DTOs.ProductoDTO>())
        .OrderBy(p => p.Nombre)
        .ToList();
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<partial name="_AdminTabs" />

<header class="encabezado">
    <div>
        <span class="antetitulo">Administración</span>
        <h1>Productos</h1>
        <p>Registra productos nuevos con sus imágenes y etiquetas, o edita los existentes desde la tabla.</p>
    </div>
</header>

<div class="row g-4">
    <div class="col-xl-7">
        <form asp-action="Crear" method="post" enctype="multipart/form-data" class="panel" id="formProducto">
            <h2 class="panel-titulo"><i class="bi bi-plus-circle"></i>Nuevo producto</h2>
            <partial name="_FormProducto" model="Model" view-data="ViewData" />
            <div class="acciones-form">
                <button type="reset" class="btn btn-contorno">Limpiar</button>
                <button type="submit" class="btn btn-neon"><i class="bi bi-check2 me-1"></i>Guardar producto</button>
            </div>
        </form>
    </div>

    <div class="col-xl-5">
        <section class="panel p-0 overflow-hidden" aria-labelledby="tituloInventario">
            <div class="panel-cabecera">
                <h2 class="panel-titulo mb-0" id="tituloInventario"><i class="bi bi-box-seam"></i>Inventario</h2>
                <span class="chip">@productos.Count productos</span>
            </div>
            <div class="px-3 pb-3">
                <input type="search" class="form-control form-control-sm" placeholder="Filtrar tabla…" data-filtrar-tabla="#tablaProductos" aria-label="Filtrar productos" />
            </div>
            <div class="table-responsive tabla-scroll">
                <table class="table tabla-admin table-hover" id="tablaProductos">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Precio</th>
                            <th class="text-center">Stock</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in productos)
                        {
                            var imagen = producto.ImagenProducto?.FirstOrDefault(i => i.Principal) ?? producto.ImagenProducto?.FirstOrDefault();
                            <tr>
                                <td class="celda-flexible">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (imagen?.Foto != null)
                                        {
                                            <img class="miniatura" src="@Formato.Base64(imagen.Foto)" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="miniatura miniatura-vacia"><i class="bi bi-image"></i></span>
                                        }
                                        <div class="min-w-0">
                                            <div class="fw-semibold text-truncate" title="@producto.Nombre">@producto.Nombre</div>
                                            <small class="text-secondary d-block text-truncate">@producto.IdCategoriaNavigation?.Categoria1</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end text-nowrap">@Formato.Colones(producto.Precio)</td>
                                <td class="text-center">
                                    <span class="chip @(producto.Stock == 0 ? "chip-apagado" : producto.Stock <= 5 ? "chip-aviso" : "chip-exito")">@producto.Stock</span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a class="btn-tabla" asp-action="Editar" asp-route-id="@producto.IdProducto" title="Editar" aria-label="Editar @producto.Nombre"><i class="bi bi-pencil"></i></a>
                                    <a class="btn-tabla" asp-action="Details" asp-route-id="@producto.IdProducto" title="Ver en la tienda" aria-label="Ver @producto.Nombre"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
