@model Tienda.Application.DTOs.ProductoDTO

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="productos-container" style="width: 100%;margin: 20px 0;">
    <h2 class="categoria-title" style="padding: 10px 0;color: #DEDEDF; font-weight: bold;font-size: 1.5rem;text-align: initial;">Mantenimientos Productos</h2>

    <form asp-action="Crear" method="post" asp-antiforgery="true" enctype="multipart/form-data" style="width: 90%" id="productForm">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="form-group">
                    <label class="control-label" style="color: #DEDEDF">Nombre</label>
                    <input class="form-control" asp-for="Nombre" required
                           oninvalid="this.setCustomValidity('Por favor ingresa el nombre del producto')"
                           oninput="this.setCustomValidity('')" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="form-group">
                    <label class="control-label" style="color: #DEDEDF">Cantidad</label>
                    <input type="number" class="form-control" asp-for="Stock" required
                           min="0" step="1"
                           oninvalid="this.setCustomValidity('La cantidad debe ser un número válido')"
                           oninput="this.setCustomValidity('')" />
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="form-group">
                    <label class="control-label" style="color: #DEDEDF">Precio</label>
                    <input type="number" min="0.01" step="0.01" class="form-control" asp-for="Precio" required
                           oninvalid="this.setCustomValidity('El precio debe ser un número válido mayor a 0')"
                           oninput="this.setCustomValidity('')" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>
            </div>

            <!-- Categorias -->
            <div class="col-md-4 mb-3">
                <div class="form-group">
                    <label class="control-label" style="color: #DEDEDF">Categoría</label>
                    <select asp-for="IdCategoria" class="form-control" required
                            oninvalid="this.setCustomValidity('Por favor selecciona una categoría')"
                            oninput="this.setCustomValidity('')">
                        <option value="">Seleccione una categoría</option>
                        @foreach (var categoria in ViewBag.ListCategorias)
                        {
                            <option value="@categoria.IdCategoria">@categoria.Categoria1</option>
                        }
                    </select>
                    <span asp-validation-for="IdCategoria" class="text-danger"></span>
                </div>
            </div>

            <!-- Etiquetas -->
            <div class="col-md-4 mb-3">
                <div class="form-group">
                    <label class="control-label" style="color: #DEDEDF">Etiquetas</label>
                    <div class="dropdown">
                        <button class="form-control text-start dropdown-toggle" type="button"
                                id="dropdownEtiquetas" data-bs-toggle="dropdown"
                                aria-expanded="false">
                            Etiquetas
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownEtiquetas" style="width:100%">
                            @foreach (var etiqueta in ViewBag.ListEtiquetas)
                            {
                                <li class="ps-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="selectedEtiqueta"
                                               value="@etiqueta.IdEtiqueta"
                                               id="etiqueta_@etiqueta.IdEtiqueta">
                                        <label class="form-check-label" for="etiqueta_@etiqueta.IdEtiqueta">
                                            @etiqueta.Etiqueta1
                                        </label>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-12 mb-3">
                <div class="form-group">
                    <label class="control-label" style="color: #DEDEDF">Descripción</label>
                    <textarea class="form-control" asp-for="Descripcion" required
                              oninvalid="this.setCustomValidity('Por favor ingresa una descripción')"
                              oninput="this.setCustomValidity('')"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>


            <div class="col-md-12 mb-3">
                <div class="form-group">
                    <label class="control-label" style="color: #DEDEDF">Imágenes del producto</label>
                    <input type="file" id="imageUpload" name="imageFiles" multiple accept="image/*" />

                    <div class="image-preview-container" id="imagePreviewContainer"></div>
                </div>
            </div>

            <div class="col-md-12 mt-4">
                <button type="submit" class="btn" style="padding: 10px 25px; background-color: #00abf0; color: white;text-decoration: none;border-radius: 30px; font-weight: 500;">
                    Guardar
                </button>
            </div>
        </div>
    </form>
</div>
<div class="container mt-5">
    <h2 class="categoria-title" style="padding: 10px 0;color: #DEDEDF; font-weight: bold;font-size: 1.5rem;text-align: initial;">Productos</h2>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th style="color: #DEDEDF">Imagen</th>
                    <th style="color: #DEDEDF">Nombre</th>
                    <th style="color: #DEDEDF">Precio</th>
                    <th style="color: #DEDEDF">Stock</th>
                    <th style="color: #DEDEDF">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.Productos != null)
                {
                    @foreach (var producto in ViewBag.Productos)
                    {
                        <tr>
                            <td>
                                @{
                                    var imagenes = producto.ImagenProducto as IEnumerable<Tienda.Application.DTOs.ImagenProductoDTO>;
                                    var imagenPrincipal = imagenes?.FirstOrDefault(i => i.Principal == true) ?? imagenes?.FirstOrDefault();
                                }
                                @if (imagenPrincipal?.Foto != null)
                                {
                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(imagenPrincipal.Foto)"
                                         style="width: 50px; height: 50px; object-fit: cover;"
                                         alt="Imagen del producto">
                                }
                            </td>
                            <td style="color: #DEDEDF">@producto.Nombre</td>
                            <td style="color: #DEDEDF">@(producto.Precio?.ToString("C"))</td>
                            <td style="color: #DEDEDF">@producto.Stock</td>
                            <td>
                                <a style="padding: 10px 25px;background-color: Transparent;border: 1px solid #00abf0;box-shadow: 0 10px 15px #00abf0; color: white;text-decoration: none;border-radius: 20px; font-weight: 500;" class="btn btn-sm" asp-action="Editar" asp-route-id="@producto.IdProducto">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


@section Styles {
    <style>
        .image-preview-container {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        .image-preview-item {
            position: relative;
        }

            .image-preview-item img {
                border: 1px solid #ddd;
                border-radius: 4px;
            }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Si hay mensaje de éxito, limpiar el formulario
            if (document.querySelector('.alert-success')) {
                document.getElementById("productForm").reset();
                document.getElementById("imagePreviewContainer").innerHTML = '';
            }

            // Previsualización de imágenes
            document.getElementById('imageUpload').addEventListener('change', function () {
                const container = document.getElementById('imagePreviewContainer');
                container.innerHTML = '';

                if (this.files && this.files.length > 0) {
                    for (let i = 0; i < this.files.length; i++) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const div = document.createElement('div');
                            div.className = 'image-preview-item';
                            div.innerHTML = `<img src="${e.target.result}" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;">`;
                            container.appendChild(div);
                        }
                        reader.readAsDataURL(this.files[i]);
                    }
                }
            });

            // Validación de archivos antes de enviar
            document.getElementById('productForm').addEventListener('submit', function (e) {
                const files = document.getElementById('imageUpload').files;
                if (files.length > 0) {
                    for (let i = 0; i < files.length; i++) {
                        if (!files[i].type.match('image.*')) {
                            alert('Por favor, sube solo archivos de imagen');
                            e.preventDefault();
                            return false;
                        }
                    }
                }
                return true;
            });
        });
    </script>
}