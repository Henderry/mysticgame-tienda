@model Tienda.Application.DTOs.ProductoDTO
@using Tienda.Web.Models
@using Tienda.Web.Util
@{
    ViewData["Title"] = Model.Nombre;
    var oferta = ViewBag.Oferta as OfertaActiva;
    var relacionados = ViewBag.Relacionados as List<ProductoCardViewModel> ?? new();
    var etiquetas = ViewBag.EtiquetasDelProducto as List<string?> ?? new();
    var imagenes = Model.ImagenProducto?.OrderByDescending(i => i.Principal).ToList() ?? new();
    var principal = imagenes.FirstOrDefault();
    var precio = Model.Precio ?? 0m;
    var precioFinal = oferta?.PrecioFinal(precio) ?? precio;
    var resenas = Model.Resena?.OrderByDescending(r => r.Fecha).ToList() ?? new();
    var valoradas = resenas.Where(r => r.Valoracion is >= 1 and <= 5).ToList();
    var promedio = valoradas.Any() ? valoradas.Average(r => (double)r.Valoracion) : 0;
}
@section Styles {
    <link rel="stylesheet" href="~/css/styleProductos.css" asp-append-version="true" />
}

<nav class="migas" aria-label="Ruta">
    <a asp-controller="Home" asp-action="Index">Inicio</a><i class="bi bi-chevron-right"></i>
    <a asp-controller="Producto" asp-action="Index">Productos</a><i class="bi bi-chevron-right"></i>
    @if (Model.IdCategoriaNavigation != null)
    {
        <a asp-controller="Home" asp-action="CategoriaxProducto" asp-route-id="@Model.IdCategoria">@Model.IdCategoriaNavigation.Categoria1</a><i class="bi bi-chevron-right"></i>
    }
    <span>@Model.Nombre</span>
</nav>

<section class="detalle" data-producto
         data-id="@Model.IdProducto"
         data-nombre="@Model.Nombre"
         data-precio="@precioFinal.ToString(System.Globalization.CultureInfo.InvariantCulture)">
    <div class="galeria">
        <div class="galeria-principal">
            @if (principal?.Foto != null)
            {
                <img id="imagenPrincipal" src="@Formato.Base64(principal.Foto)" alt="@Model.Nombre" />
            }
            else
            {
                <span class="sin-imagen"><i class="bi bi-controller"></i></span>
            }
            @if (oferta != null)
            {
                <span class="chip chip-oferta galeria-insignia">-@oferta.Porcentaje%</span>
            }
        </div>
        @if (imagenes.Count > 1)
        {
            <div class="galeria-miniaturas" role="list">
                @for (var i = 0; i < imagenes.Count; i++)
                {
                    <button type="button" class="miniatura-btn @(i == 0 ? "activa" : "")" role="listitem"
                            data-imagen="@Formato.Base64(imagenes[i].Foto)" aria-label="Ver imagen @(i + 1)">
                        <img src="@Formato.Base64(imagenes[i].Foto)" alt="" loading="lazy" />
                    </button>
                }
            </div>
        }
    </div>

    <div class="detalle-info">
        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (Model.IdCategoriaNavigation != null)
            {
                <span class="chip">@Model.IdCategoriaNavigation.Categoria1</span>
            }
            @foreach (var etiqueta in etiquetas)
            {
                <span class="chip chip-etiqueta">#@etiqueta</span>
            }
        </div>

        <h1 class="detalle-titulo">@Model.Nombre</h1>

        <a href="#resenas" class="detalle-valoracion">
            <span class="estrellas" aria-hidden="true">
                @for (var i = 1; i <= 5; i++)
                {
                    <i class="bi @(promedio >= i - 0.25 ? "bi-star-fill" : promedio >= i - 0.75 ? "bi-star-half" : "bi-star")"></i>
                }
            </span>
            @if (valoradas.Any())
            {
                <span>@promedio.ToString("0.0") · @resenas.Count @(resenas.Count == 1 ? "reseña" : "reseñas")</span>
            }
            else
            {
                <span>Sin reseñas todavía</span>
            }
        </a>

        <div class="detalle-precio">
            <strong>@Formato.Colones(precioFinal)</strong>
            @if (oferta != null)
            {
                <del>@Formato.Colones(precio)</del>
                <span class="chip chip-oferta">Ahorras @Formato.Colones(precio - precioFinal)</span>
            }
        </div>
        @if (oferta != null)
        {
            <a class="detalle-promo" asp-controller="Promocion" asp-action="Details" asp-route-id="@oferta.IdPromocion">
                <i class="bi bi-lightning-charge-fill"></i>
                <span><strong>@oferta.Nombre</strong> · válida hasta el @Formato.Fecha(oferta.FechaFin)</span>
                <i class="bi bi-chevron-right ms-auto"></i>
            </a>
        }

        <p class="detalle-descripcion">@Model.Descripcion</p>

        <div class="detalle-stock">
            @if (Model.Stock > 5)
            {
                <span class="chip chip-exito"><i class="bi bi-check2-circle"></i>En stock</span>
            }
            else if (Model.Stock > 0)
            {
                <span class="chip chip-aviso"><i class="bi bi-hourglass-split"></i>¡Solo quedan @(Model.Stock)!</span>
            }
            else
            {
                <span class="chip chip-apagado"><i class="bi bi-x-circle"></i>Agotado</span>
            }
        </div>

        <div class="detalle-compra">
            <div class="cantidad cantidad-grande" aria-label="Cantidad">
                <button type="button" data-cantidad="-1" aria-label="Menos">−</button>
                <span id="cantidadProducto" data-max="@Math.Max(Model.Stock, 1)">1</span>
                <button type="button" data-cantidad="1" aria-label="Más">+</button>
            </div>
            <button type="button" class="btn btn-neon flex-grow-1" id="agregarDetalle" @(Model.Stock <= 0 ? "disabled" : "")>
                <i class="bi bi-bag-plus me-2"></i>Agregar al carrito
            </button>
        </div>

        <ul class="detalle-beneficios">
            <li><i class="bi bi-truck"></i>Envío a todo el país</li>
            <li><i class="bi bi-shield-check"></i>Garantía de 30 días</li>
            <li><i class="bi bi-arrow-repeat"></i>Cambios sin costo</li>
        </ul>
    </div>
</section>

<!-- Reseñas -->
<section class="resenas" id="resenas" aria-labelledby="tituloResenas">
    <div class="titulo-seccion">
        <h2 id="tituloResenas">Reseñas</h2>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="panel resumen-resenas">
                <div class="promedio">
                    <strong>@(valoradas.Any() ? promedio.ToString("0.0") : "–")</strong>
                    <div>
                        <span class="estrellas" aria-hidden="true">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi @(promedio >= i - 0.25 ? "bi-star-fill" : promedio >= i - 0.75 ? "bi-star-half" : "bi-star")"></i>
                            }
                        </span>
                        <small>@resenas.Count @(resenas.Count == 1 ? "reseña" : "reseñas")</small>
                    </div>
                </div>
                @for (var estrellas = 5; estrellas >= 1; estrellas--)
                {
                    var cantidad = resenas.Count(r => r.Valoracion == estrellas);
                    var porcentaje = valoradas.Any() ? cantidad * 100 / valoradas.Count : 0;
                    <div class="barra-valoracion">
                        <span>@estrellas <i class="bi bi-star-fill"></i></span>
                        <div class="barra"><div style="width:@porcentaje%"></div></div>
                        <span>@cantidad</span>
                    </div>
                }

                <form asp-action="RegistrarResena" method="post" class="form-resena" id="formResena" novalidate>
                    <input type="hidden" name="IdProducto" value="@Model.IdProducto" />
                    <input type="hidden" name="Valoracion" id="valoracion" value="0" />
                    <h3>Escribe tu reseña</h3>
                    <p class="form-text mt-0">Publicarás como <strong>Pablo Arias</strong> (usuario de demostración).</p>
                    <div class="selector-estrellas" role="radiogroup" aria-label="Valoración">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <button type="button" role="radio" aria-checked="false" data-valor="@i" aria-label="@i de 5 estrellas">
                                <i class="bi bi-star-fill"></i>
                            </button>
                        }
                    </div>
                    <textarea name="Comentario" class="form-control" rows="3" maxlength="500"
                              placeholder="¿Qué te pareció este producto?" required></textarea>
                    <div class="text-danger small mt-2" id="errorResena" hidden></div>
                    <button type="submit" class="btn btn-neon mt-3">Publicar reseña</button>
                </form>
            </div>
        </div>

        <div class="col-lg-7">
            @if (resenas.Any())
            {
                <ul class="lista-resenas">
                    @foreach (var resena in resenas)
                    {
                        var nombre = resena.IdUsuarioNavigation?.Nombre ?? "Usuario";
                        <li class="resena">
                            <span class="avatar" style="background:@Formato.ColorAvatar(nombre)">@Formato.Iniciales(nombre)</span>
                            <div>
                                <div class="resena-cabecera">
                                    <strong>@nombre</strong>
                                    <time>@Formato.Fecha(resena.Fecha)</time>
                                </div>
                                <span class="estrellas" aria-label="@resena.Valoracion de 5 estrellas">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= resena.Valoracion ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </span>
                                <p>@resena.Comentario</p>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="panel vacio"><i class="bi bi-chat-square-heart"></i>Sé la primera persona en opinar sobre este producto.</div>
            }
        </div>
    </div>
</section>

@if (relacionados.Any())
{
    <section class="mt-5 pt-4" aria-labelledby="tituloRelacionados">
        <div class="titulo-seccion">
            <h2 id="tituloRelacionados">También te puede gustar</h2>
            <a class="enlace-flecha" asp-controller="Home" asp-action="CategoriaxProducto" asp-route-id="@Model.IdCategoria">Ver categoría <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="productos-grid">
            @foreach (var tarjeta in relacionados)
            {
                <partial name="_ProductoCard" model="tarjeta" />
            }
        </div>
    </section>
}

@section Scripts {
    <script>
        (() => {
            // Galería: cambiar la imagen principal
            const principal = document.getElementById('imagenPrincipal');
            document.querySelectorAll('.miniatura-btn').forEach(boton => {
                boton.addEventListener('click', () => {
                    principal.src = boton.dataset.imagen;
                    document.querySelectorAll('.miniatura-btn').forEach(b => b.classList.toggle('activa', b === boton));
                });
            });

            // Cantidad y carrito
            const cantidad = document.getElementById('cantidadProducto');
            const maximo = Number(cantidad.dataset.max);
            document.querySelectorAll('[data-cantidad]').forEach(boton => {
                boton.addEventListener('click', () => {
                    const valor = Math.min(maximo, Math.max(1, Number(cantidad.textContent) + Number(boton.dataset.cantidad)));
                    cantidad.textContent = valor;
                });
            });
            document.getElementById('agregarDetalle').addEventListener('click', () => {
                const detalle = document.querySelector('[data-producto]');
                MysticCarrito.agregar({
                    id: detalle.dataset.id,
                    nombre: detalle.dataset.nombre,
                    precio: Number(detalle.dataset.precio),
                    imagen: principal ? MysticCarrito.miniatura(principal) : null
                }, Number(cantidad.textContent));
            });

            // Selector de estrellas de la reseña
            const valoracion = document.getElementById('valoracion');
            const botones = document.querySelectorAll('.selector-estrellas button');
            const pintar = valor => botones.forEach((b, i) => {
                b.classList.toggle('activa', i < valor);
                b.setAttribute('aria-checked', String(i + 1 === valor));
            });
            botones.forEach(boton => {
                boton.addEventListener('click', () => { valoracion.value = boton.dataset.valor; pintar(Number(boton.dataset.valor)); });
                boton.addEventListener('mouseenter', () => pintar(Number(boton.dataset.valor)));
            });
            document.querySelector('.selector-estrellas').addEventListener('mouseleave', () => pintar(Number(valoracion.value)));

            document.getElementById('formResena').addEventListener('submit', e => {
                const error = document.getElementById('errorResena');
                const comentario = e.target.Comentario.value.trim();
                const mensaje = valoracion.value === '0' ? 'Selecciona de 1 a 5 estrellas.'
                    : comentario.length < 3 ? 'Escribe un comentario un poco más largo.' : '';
                error.textContent = mensaje;
                error.hidden = !mensaje;
                if (mensaje) e.preventDefault();
            });
        })();
    </script>
}
