@model Tienda.Application.DTOs.ProductoDTO
@using Tienda.Web.Util
@{
    ViewData["Title"] = $"Editar {Model.Nombre}";
    ViewData["CampoEtiquetas"] = "selectedEtiquetas";
    var imagenes = Model.ImagenProducto?.OrderByDescending(i => i.Principal).ToList() ?? new();
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<partial name="_AdminTabs" />

<nav class="migas" aria-label="Ruta">
    <a asp-controller="Producto" asp-action="Crear">Productos</a><i class="bi bi-chevron-right"></i>
    <span>Editar</span>
</nav>

<header class="encabezado">
    <div>
        <span class="antetitulo">Administración</span>
        <h1>@Model.Nombre</h1>
        <p>Actualiza la información, las etiquetas y las imágenes del producto.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-contorno" asp-action="Details" asp-route-id="@Model.IdProducto"><i class="bi bi-eye me-1"></i>Ver en la tienda</a>
    </div>
</header>

<div class="row g-4">
    <div class="col-xl-7">
        <form asp-action="Editar" method="post" enctype="multipart/form-data" class="panel" id="formProducto">
            <input type="hidden" asp-for="IdProducto" />
            <h2 class="panel-titulo"><i class="bi bi-pencil-square"></i>Datos del producto</h2>
            <partial name="_FormProducto" model="Model" view-data="ViewData" />
            <div class="acciones-form">
                <a class="btn btn-contorno" asp-action="Crear">Cancelar</a>
                <button type="submit" class="btn btn-neon"><i class="bi bi-check2 me-1"></i>Guardar cambios</button>
            </div>
        </form>
    </div>

    <div class="col-xl-5">
        <section class="panel" aria-labelledby="tituloImagenes">
            <h2 class="panel-titulo" id="tituloImagenes"><i class="bi bi-images"></i>Imágenes actuales <span class="chip ms-auto">@imagenes.Count</span></h2>
            @if (imagenes.Any())
            {
                <div class="imagenes-admin">
                    @foreach (var imagen in imagenes)
                    {
                        <figure class="imagen-admin">
                            <img src="@Formato.Base64(imagen.Foto)" alt="Imagen del producto" loading="lazy" />
                            @if (imagen.Principal)
                            {
                                <span class="chip imagen-principal"><i class="bi bi-star-fill"></i>Principal</span>
                            }
                            <form asp-action="DeleteEImagen" method="post" data-confirmar="¿Eliminar esta imagen?">
                                <input type="hidden" name="idProducto" value="@Model.IdProducto" />
                                <input type="hidden" name="idImagen" value="@imagen.IdImagen" />
                                <button type="submit" class="btn-eliminar-imagen" aria-label="Eliminar imagen"><i class="bi bi-trash3"></i></button>
                            </form>
                        </figure>
                    }
                </div>
            }
            else
            {
                <p class="text-secondary mb-0">Este producto todavía no tiene imágenes. Agrégalas desde el formulario.</p>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
