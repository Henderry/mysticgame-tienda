@model Tienda.Application.DTOs.PromocionDTO
@{
    ViewData["Title"] = $"Editar {Model.Nombre}";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<partial name="_AdminTabs" />

<nav class="migas" aria-label="Ruta">
    <a asp-controller="Promocion" asp-action="Crear">Promociones</a><i class="bi bi-chevron-right"></i>
    <span>Editar</span>
</nav>

<header class="encabezado">
    <div>
        <span class="antetitulo">Administración</span>
        <h1>@Model.Nombre</h1>
        <p>Los cambios se reflejan de inmediato en los precios de la tienda.</p>
    </div>
    <a class="btn btn-contorno" asp-action="Details" asp-route-id="@Model.IdPromocion"><i class="bi bi-eye me-1"></i>Ver en la tienda</a>
</header>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <form asp-action="Editar" method="post" class="panel" id="formPromocion">
            <input type="hidden" asp-for="IdPromocion" />
            <h2 class="panel-titulo"><i class="bi bi-pencil-square"></i>Datos de la promoción</h2>
            <partial name="_FormPromocion" model="Model" />
            <div class="acciones-form">
                <a class="btn btn-contorno" asp-action="Crear">Cancelar</a>
                <button type="submit" class="btn btn-neon"><i class="bi bi-check2 me-1"></i>Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
