@model Tienda.Application.DTOs.PromocionDTO

@{
    ViewData["Title"] = "Crear Promoción";
    // Obtiene la lista de promociones para mostrar en la tabla
    var promociones = ViewBag.ListPromocion as IEnumerable<Tienda.Application.DTOs.PromocionDTO> ?? Enumerable.Empty<Tienda.Application.DTOs.PromocionDTO>();
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
    <style>
        /* Tabla de promociones */
        .promo-table th, .promo-table td {
            color: #DEDEDF;
            vertical-align: middle;
        }

        .promo-table .btn {
            padding: 5px 15px;
            background-color: transparent;
            border-radius: 20px;
            color: white;
        }

        .promo-table .btn-edit {
            border: 1px solid #00abf0;
            box-shadow: 0 5px 10px #00abf0;
        }

        .promo-table .btn-view {
            border: 1px solid #2E3E40;
        }
    </style>
}

<h2 class="categoria-title" style="padding:10px 0; color:#DEDEDF; font-weight:bold; font-size:1.5rem;">
    Crear Promoción
</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="productos-container" style="width:100%; margin:20px 0;">
    <form asp-action="Crear"
          method="post"
          asp-antiforgery="true"
          enctype="multipart/form-data"
          style="width:90%;"
          id="promocionForm">
        @Html.AntiForgeryToken()
        <div class="row">
            <!-- Nombre -->
            <div class="col-md-6 mb-3">
                <label class="control-label" style="color:#DEDEDF">Nombre</label>
                <input asp-for="Nombre" class="form-control" required />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <!-- Fecha Inicio -->
            <div class="col-md-3 mb-3">
                <label asp-for="FechaInicio" class="control-label" style="color:#DEDEDF">Fecha Inicio</label>
                <input asp-for="FechaInicio"
                       type="date"
                       class="form-control"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       required />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <!-- Fecha Fin -->
            <div class="col-md-3 mb-3">
                <label asp-for="FechaFin" class="control-label" style="color:#DEDEDF">Fecha Fin</label>
                <input asp-for="FechaFin"
                       type="date"
                       class="form-control"
                       value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")"
                       required />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>

            <!-- Descuento -->
            <div class="col-md-3 mb-3">
                <label class="control-label" style="color:#DEDEDF">% Descuento</label>
                <input asp-for="Descuento"
                       type="number"
                       min="0.01"
                       step="0.01"
                       class="form-control"
                       required />
                <span asp-validation-for="Descuento" class="text-danger"></span>
            </div>

            <!-- Tipo Promoción -->
            <div class="col-md-4 mb-3">
                <label class="control-label" style="color:#DEDEDF">Tipo Promoción</label>
                <select asp-for="IdTipoPromocion"
                        id="tipoPromocionSelect"
                        class="form-control"
                        required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var tipo in ViewBag.TipoPromocion)
                    {
                        <option value="@tipo.IdTipoPromocion">@tipo.Tipo</option>
                    }
                </select>
                <span asp-validation-for="IdTipoPromocion" class="text-danger"></span>
            </div>

            <!-- Productos (solo tipo 1) -->
            <div class="col-md-4 mb-3" id="productosDropdownContainer" style="display:none;">
                <label class="control-label" style="color:#DEDEDF">Productos</label>
                <div class="dropdown">
                    <button class="form-control text-start dropdown-toggle"
                            id="dropdownProducto"
                            data-bs-toggle="dropdown">
                        Seleccionar productos
                    </button>
                    <ul class="dropdown-menu" style="width:100%">
                        @foreach (var producto in ViewBag.Productos)
                        {
                            <li class="ps-3">
                                <div class="form-check">
                                    <input class="form-check-input producto-checkbox"
                                           type="checkbox"
                                           name="selectedProducto"
                                           value="@producto.IdProducto"
                                           id="producto_@producto.IdProducto" />
                                    <label class="form-check-label"
                                           for="producto_@producto.IdProducto">
                                        @producto.Nombre
                                    </label>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <div id="selectedProductsText" class="small text-muted mt-1"></div>
            </div>

            <!-- Categorías (solo tipo 2) -->
            <div class="col-md-4 mb-3" id="categoriasDropdownContainer" style="display:none;">
                <label class="control-label" style="color:#DEDEDF">Categorías</label>
                <div class="dropdown">
                    <button class="form-control text-start dropdown-toggle"
                            id="dropdownCategoria"
                            data-bs-toggle="dropdown">
                        Seleccionar categorías
                    </button>
                    <ul class="dropdown-menu" style="width:100%">
                        @foreach (var categoria in ViewBag.ListCategorias)
                        {
                            <li class="ps-3">
                                <div class="form-check">
                                    <input class="form-check-input categoria-checkbox"
                                           type="checkbox"
                                           name="selectedCategoria"
                                           value="@categoria.IdCategoria"
                                           id="categoria_@categoria.IdCategoria" />
                                    <label class="form-check-label"
                                           for="categoria_@categoria.IdCategoria">
                                        @categoria.Categoria1
                                    </label>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <div id="selectedCategoriesText" class="small text-muted mt-1"></div>
            </div>

            <!-- Descripción -->
            <div class="col-md-12 mb-3">
                <label class="control-label" style="color:#DEDEDF">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" required></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <!-- Botón Guardar -->
            <div class="col-md-12 mt-4">
                <button type="submit"
                        class="btn"
                        style="background-color:#00abf0;color:white;
                               padding:10px 25px;border-radius:30px;
                               font-weight:500;">
                    Guardar
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Tabla de Mantenimiento de Promociones -->
<div class="table-responsive mt-5">
    <h2 class="categoria-title" style="padding:10px 0; color:#DEDEDF; font-weight:bold; font-size:1.5rem;">
        Mantenimiento de Promociones
    </h2>
    <table class="table table-striped table-hover promo-table">
        <thead class="thead-dark">
            <tr>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>% Descuento</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (promociones.Any())
            {
                foreach (var promo in promociones)
                {
                    <tr>
                        <td>@promo.Nombre</td>
                        <td>@promo.IdTipoPromocionNavigation?.Tipo</td>
                        <td>@promo.FechaInicio?.ToString("yyyy-MM-dd")</td>
                        <td>@promo.FechaFin?.ToString("yyyy-MM-dd")</td>
                        <td>@($"{promo.Descuento:P0}")</td>
                        <td>
                            <a asp-action="Editar"
                               asp-route-id="@promo.IdPromocion"
                               class="btn btn-sm btn-edit">
                                Editar
                            </a>
                            <a asp-action="Details"
                               asp-route-id="@promo.IdPromocion"
                               class="btn btn-sm btn-view ms-1">
                                Ver
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No hay promociones registradas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tipoSelect = document.getElementById('tipoPromocionSelect');
            const prodDiv = document.getElementById('productosDropdownContainer');
            const catDiv = document.getElementById('categoriasDropdownContainer');

            function toggleDropdowns(value) {
                if (value === '1') {
                    prodDiv.style.display = 'block';
                    catDiv.style.display = 'none';
                    clearChecks('selectedCategoria');
                } else if (value === '2') {
                    prodDiv.style.display = 'none';
                    catDiv.style.display = 'block';
                    clearChecks('selectedProducto');
                } else {
                    prodDiv.style.display = catDiv.style.display = 'none';
                }
                updateText('producto', 'selectedProductsText');
                updateText('categoria', 'selectedCategoriesText');
            }

            function clearChecks(name) {
                document.querySelectorAll(`input[name="${name}"]`)
                    .forEach(cb => cb.checked = false);
            }

            function updateText(type, containerId) {
                const checks = document.querySelectorAll(`input[name="selected${type.charAt(0).toUpperCase() + type.slice(1)}"]:checked`);
                const textDiv = document.getElementById(containerId);
                if (checks.length > 0) {
                    const names = Array.from(checks).map(cb => cb.nextElementSibling.textContent.trim());
                    textDiv.textContent = `Seleccionados: ${names.join(', ')}`;
                    textDiv.style.display = 'block';
                } else {
                    textDiv.style.display = 'none';
                }
            }

            tipoSelect.addEventListener('change', e => toggleDropdowns(e.target.value));

            document.querySelectorAll('.producto-checkbox').forEach(cb =>
                cb.addEventListener('change', () => updateText('producto', 'selectedProductsText'))
            );
            document.querySelectorAll('.categoria-checkbox').forEach(cb =>
                cb.addEventListener('change', () => updateText('categoria', 'selectedCategoriesText'))
            );

            document.getElementById('promocionForm').addEventListener('submit', e => {
                const tipo = tipoSelect.value;
                const hasProd = document.querySelectorAll('input[name="selectedProducto"]:checked').length > 0;
                const hasCat = document.querySelectorAll('input[name="selectedCategoria"]:checked').length > 0;
                if (tipo === '1' && !hasProd) {
                    alert('Debe seleccionar al menos un producto para promoción por producto');
                    e.preventDefault();
                }
                if (tipo === '2' && !hasCat) {
                    alert('Debe seleccionar al menos una categoría para promoción por categoría');
                    e.preventDefault();
                }
            });

            // Inicializa la vista según el valor por defecto
            toggleDropdowns(tipoSelect.value);
        });
    </script>
}
