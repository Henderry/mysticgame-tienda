@model Tienda.Application.DTOs.PromocionDTO
@using Tienda.Web.Models
@using Tienda.Web.Util
@{
    ViewData["Title"] = "Administrar promociones";
    var promociones = (ViewBag.ListPromocion as IEnumerable<Tienda.Application.DTOs.PromocionDTO> ?? Enumerable.Empty<Tienda.Application.DTOs.PromocionDTO>())
        .OrderBy(p => p.Estado())
        .ThenByDescending(p => p.FechaInicio)
        .ToList();
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<partial name="_AdminTabs" />

<header class="encabezado">
    <div>
        <span class="antetitulo">Administración</span>
        <h1>Promociones</h1>
        <p>Crea descuentos para productos específicos o para categorías completas. Se aplican solos en la tienda entre las fechas indicadas.</p>
    </div>
</header>

<div class="row g-4">
    <div class="col-xl-6">
        <form asp-action="Crear" method="post" class="panel" id="formPromocion">
            <h2 class="panel-titulo"><i class="bi bi-plus-circle"></i>Nueva promoción</h2>
            <partial name="_FormPromocion" model="Model" />
            <div class="acciones-form">
                <button type="reset" class="btn btn-contorno">Limpiar</button>
                <button type="submit" class="btn btn-neon"><i class="bi bi-check2 me-1"></i>Guardar promoción</button>
            </div>
        </form>
    </div>

    <div class="col-xl-6">
        <section class="panel p-0 overflow-hidden" aria-labelledby="tituloPromos">
            <div class="panel-cabecera">
                <h2 class="panel-titulo mb-0" id="tituloPromos"><i class="bi bi-list-ul"></i>Promociones registradas</h2>
                <span class="chip">@promociones.Count</span>
            </div>
            <div class="table-responsive tabla-scroll">
                <table class="table tabla-admin table-hover">
                    <thead>
                        <tr>
                            <th>Promoción</th>
                            <th class="text-center">Desc.</th>
                            <th>Vigencia</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!promociones.Any())
                        {
                            <tr><td colspan="4" class="text-center text-secondary py-4">No hay promociones registradas.</td></tr>
                        }
                        @foreach (var promo in promociones)
                        {
                            var estado = promo.Estado();
                            <tr>
                                <td class="celda-flexible">
                                    <div class="fw-semibold text-truncate" title="@promo.Nombre">@promo.Nombre</div>
                                    <small class="text-secondary">@(promo.IdTipoPromocion == 1 ? "Por producto" : "Por categoría")</small>
                                </td>
                                <td class="text-center"><span class="chip">@((int)Math.Round((promo.Descuento ?? 0) * 100))%</span></td>
                                <td class="text-nowrap">
                                    <span class="punto-estado estado-@estado.Clase()" title="@estado.Texto()"></span>
                                    <small>@Formato.Fecha(promo.FechaInicio) – @Formato.Fecha(promo.FechaFin)</small>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a class="btn-tabla" asp-action="Editar" asp-route-id="@promo.IdPromocion" title="Editar" aria-label="Editar @promo.Nombre"><i class="bi bi-pencil"></i></a>
                                    <a class="btn-tabla" asp-action="Details" asp-route-id="@promo.IdPromocion" title="Ver en la tienda" aria-label="Ver @promo.Nombre"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
