@model Tienda.Web.Models.PromocionDetalleViewModel
@using Tienda.Web.Models
@using Tienda.Web.Util
@{
    var promo = Model.Promocion;
    ViewData["Title"] = promo.Nombre;
    var estado = promo.Estado();
    var dias = promo.DiasRestantes();
    var porcentaje = (int)Math.Round((promo.Descuento ?? 0) * 100);
}
@section Styles {
    <link rel="stylesheet" href="~/css/stylePromocion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styleProductos.css" asp-append-version="true" />
}

<nav class="migas" aria-label="Ruta">
    <a asp-controller="Home" asp-action="Index">Inicio</a><i class="bi bi-chevron-right"></i>
    <a asp-controller="Promocion" asp-action="Index">Promociones</a><i class="bi bi-chevron-right"></i>
    <span>@promo.Nombre</span>
</nav>

<section class="promo-hero promo-@estado.Clase()">
    <div class="promo-hero-descuento">
        <div>
            <strong>-@porcentaje<span>%</span></strong>
            <small>descuento</small>
        </div>
    </div>
    <div>
        <div class="d-flex flex-wrap gap-2">
            <span class="chip promo-estado">@estado.Texto()</span>
            <span class="chip chip-apagado"><i class="bi @(Model.EsPorCategoria ? "bi-grid" : "bi-box")"></i>@Model.Alcance</span>
        </div>
        <h1>@promo.Nombre</h1>
        <p>@promo.Descripcion</p>
        <div class="promo-hero-datos">
            <span><i class="bi bi-calendar-event"></i>Del @Formato.Fecha(promo.FechaInicio) al @Formato.Fecha(promo.FechaFin)</span>
            @if (estado == EstadoPromocion.Activa && dias != null)
            {
                <span><i class="bi bi-hourglass-split"></i>@(dias == 0 ? "Termina hoy" : dias == 1 ? "Termina mañana" : $"Quedan {dias} días")</span>
            }
            <span><i class="bi bi-tag"></i>@Model.Productos.Count @(Model.Productos.Count == 1 ? "producto incluido" : "productos incluidos")</span>
        </div>
    </div>
</section>

@if (estado != EstadoPromocion.Activa)
{
    <div class="panel d-flex align-items-center gap-3 mb-4 py-3">
        <i class="bi bi-info-circle fs-4 text-info"></i>
        <span>
            @(estado == EstadoPromocion.Proxima
                ? $"Esta promoción empieza el {Formato.Fecha(promo.FechaInicio)}. Los precios mostrados son los que tendrán los productos durante la promoción."
                : "Esta promoción ya finalizó. Los precios mostrados son los que tuvo durante su vigencia.")
        </span>
    </div>
}

<div class="titulo-seccion">
    <h2>Productos en promoción</h2>
</div>

@if (Model.Productos.Any())
{
    <div class="productos-grid">
        @foreach (var tarjeta in Model.Productos)
        {
            <partial name="_ProductoCard" model="tarjeta" />
        }
    </div>
}
else
{
    <div class="panel vacio"><i class="bi bi-box-seam"></i>Esta promoción no tiene productos asociados.</div>
}
