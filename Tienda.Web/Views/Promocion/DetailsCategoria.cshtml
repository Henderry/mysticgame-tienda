@{
    var promocion = ViewBag.Promocion as Tienda.Application.DTOs.PromocionDTO;
    var categoria = ViewBag.Categoria as Tienda.Application.DTOs.CategoriaDTO;
    var productos = ViewBag.Productos as List<dynamic>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/stylePromocion.css">
    <style>
        .precio-original {
            text-decoration: line-through;
            color: #aaa;
            font-size: 0.9em;
            margin-right: 8px;
        }

        .precio-descuento {
            color: #00abf0;
            font-weight: bold;
            font-size: 1.1em;
        }

        .badge-promo {
            background-color: #ff4757;
            color: white;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 0.8em;
            margin-left: 8px;
        }

        .producto-card-promo {
            border: 2px solid rgba(0, 171, 240, 0.3);
            position: relative;
            transition: transform 0.3s;
        }

            .producto-card-promo:hover {
                transform: scale(1.03);
            }

            .producto-card-promo::before {
                content: "EN OFERTA";
                position: absolute;
                top: 10px;
                right: 10px;
                background-color: #00abf0;
                color: white;
                padding: 3px 8px;
                border-radius: 4px;
                font-size: 0.8em;
                z-index: 2;
            }

        .promocion-header {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
        }

        .productos-grid, .categorias-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            padding: 10px;
        }

        .categoria-card {
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }
    </style>
}

<div class="promocion-details-container">
    <div class="promocion-header">
        <h1>@promocion.Nombre</h1>
        <div class="promocion-meta">
            <span class="badge-promo">@string.Format("{0:0}% OFF", promocion.Descuento * 100)</span>
            <span>Válido hasta: @promocion.FechaFin.Value.ToString("dd/MM/yyyy")</span>
        </div>
        <p class="promocion-descripcion">@promocion.Descripcion</p>
    </div>

    <h2>Categoría en oferta: @categoria.Categoria1</h2>

    @if (productos != null && productos.Count > 0)
    {
        <div class="categoria-card">
            <p>Todos los productos con @string.Format("{0:0}% de descuento", promocion.Descuento * 100)</p>

            <div class="productos-grid">
                @foreach (var item in productos)
                {
                    var producto = item.Producto as Tienda.Application.DTOs.ProductoDTO;
                    var imagen = item.ImagenPrincipal as Tienda.Application.DTOs.ImagenProductoDTO;
                    var precioDescuento = producto.Precio * (1 - promocion.Descuento);

                    <div class="producto-card producto-card-promo">
                        @if (imagen?.Foto != null)
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(imagen.Foto)"
                                 alt="@producto.Nombre" class="producto-imagen" />
                        }
                        else
                        {
                            <img src="~/img/default-product.jpg" alt="Imagen no disponible" class="producto-imagen" />
                        }

                        <div class="producto-info">
                            <h3 class="producto-nombre">@producto.Nombre</h3>
                            <div class="producto-precio-container">
                                <span class="precio-original">₡@producto.Precio?.ToString("N2")</span>
                                <span class="precio-descuento">₡@precioDescuento?.ToString("N2")</span>
                            </div>
                            <div class="producto-acciones">
                                <a asp-controller="Producto" asp-action="Details" asp-route-id="@producto.IdProducto"
                                   class="btn-ver-detalle">Ver detalle</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay productos disponibles en esta categoría.
        </div>
    }
</div>