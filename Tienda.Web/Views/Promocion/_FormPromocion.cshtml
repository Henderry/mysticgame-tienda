@model Tienda.Application.DTOs.PromocionDTO
@using System.Globalization
@{
    var tipos = ViewBag.TipoPromocion as IEnumerable<Tienda.Application.DTOs.TipoPromocionDTO> ?? Enumerable.Empty<Tienda.Application.DTOs.TipoPromocionDTO>();
    var productos = (ViewBag.Productos as IEnumerable<Tienda.Application.DTOs.ProductoDTO> ?? Enumerable.Empty<Tienda.Application.DTOs.ProductoDTO>()).OrderBy(p => p.Nombre);
    var categorias = (ViewBag.ListCategorias as IEnumerable<Tienda.Application.DTOs.CategoriaDTO> ?? Enumerable.Empty<Tienda.Application.DTOs.CategoriaDTO>()).OrderBy(c => c.Categoria1);
    var productosSel = ViewBag.SelectedProductos as List<int> ?? new List<int>();
    var categoriasSel = ViewBag.SelectedCategorias as List<int> ?? new List<int>();
    var porcentaje = Model.Descuento is > 0m ? Math.Round(Model.Descuento.Value * 100, 0).ToString(CultureInfo.InvariantCulture) : "";
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej.: Semana gamer" required maxlength="100" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label for="descuentoPorcentaje" class="form-label">Descuento</label>
        <div class="input-group">
            <input type="number" id="descuentoPorcentaje" class="form-control" min="1" max="99" step="1"
                   value="@porcentaje" placeholder="15" required />
            <span class="input-group-text">%</span>
        </div>
        @* El valor real se guarda como fracción (15 % → 0.15) *@
        <input type="hidden" asp-for="Descuento" id="descuento" />
        <span asp-validation-for="Descuento" class="text-danger small"></span>
    </div>

    <div class="col-sm-6">
        <label asp-for="FechaInicio" class="form-label">Inicio</label>
        <input asp-for="FechaInicio" type="date" class="form-control" required />
        <span asp-validation-for="FechaInicio" class="text-danger small"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="FechaFin" class="form-label">Fin</label>
        <input asp-for="FechaFin" type="date" class="form-control" required />
        <span asp-validation-for="FechaFin" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <span class="form-label d-block">¿A qué se aplica?</span>
        <div class="selector-tipo" role="radiogroup" aria-label="Tipo de promoción">
            @foreach (var tipo in tipos)
            {
                var id = $"tipo_{tipo.IdTipoPromocion}";
                <input type="radio" class="btn-check" name="IdTipoPromocion" id="@id" value="@tipo.IdTipoPromocion"
                       @(Model.IdTipoPromocion == tipo.IdTipoPromocion ? "checked" : "") required />
                <label class="tipo-opcion" for="@id">
                    <i class="bi @(tipo.IdTipoPromocion == 1 ? "bi-box" : "bi-grid")"></i>
                    <span>
                        <strong>@(tipo.IdTipoPromocion == 1 ? "Por producto" : "Por categoría")</strong>
                        <small>@(tipo.IdTipoPromocion == 1 ? "Productos específicos" : "Todos los productos de una o más categorías")</small>
                    </span>
                </label>
            }
        </div>
        <span asp-validation-for="IdTipoPromocion" class="text-danger small"></span>
    </div>

    <div class="col-12" data-seleccion-tipo="1" hidden>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="form-label mb-0">Productos incluidos</span>
            <small class="text-secondary" data-contador-seleccion>0 seleccionados</small>
        </div>
        <input type="search" class="form-control form-control-sm mb-2" placeholder="Buscar producto…" data-buscar-opciones aria-label="Buscar producto" />
        <div class="lista-opciones">
            @foreach (var producto in productos)
            {
                <label class="opcion">
                    <input type="checkbox" class="form-check-input" name="selectedProducto" value="@producto.IdProducto"
                           @(productosSel.Contains(producto.IdProducto) ? "checked" : "") />
                    <span>@producto.Nombre</span>
                    <small>@producto.IdCategoriaNavigation?.Categoria1</small>
                </label>
            }
        </div>
    </div>

    <div class="col-12" data-seleccion-tipo="2" hidden>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="form-label mb-0">Categorías incluidas</span>
            <small class="text-secondary" data-contador-seleccion>0 seleccionadas</small>
        </div>
        <div class="chips-seleccion">
            @foreach (var categoria in categorias)
            {
                <input type="checkbox" class="btn-check" name="selectedCategoria" value="@categoria.IdCategoria"
                       id="categoria_@categoria.IdCategoria" autocomplete="off"
                       @(categoriasSel.Contains(categoria.IdCategoria) ? "checked" : "") />
                <label class="chip-opcion" for="categoria_@categoria.IdCategoria">@categoria.Categoria1</label>
            }
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" rows="3" required
                  placeholder="Texto que verán los clientes en la tienda"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="alert alert-danger py-2 mb-0" data-error-promocion hidden></div>
    </div>
</div>
