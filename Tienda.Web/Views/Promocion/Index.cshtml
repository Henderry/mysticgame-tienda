@model List<Tienda.Application.DTOs.PromocionDTO>
@using Tienda.Web.Models
@{
    ViewData["Title"] = "Promociones";
    int Contar(EstadoPromocion e) => Model.Count(p => p.Estado() == e);
}
@section Styles {
    <link rel="stylesheet" href="~/css/stylePromocion.css" asp-append-version="true" />
}

<header class="encabezado">
    <div>
        <span class="antetitulo">Ahorra en tus compras</span>
        <h1>Promociones</h1>
        <p>Descuentos por producto o por categoría completa. El precio con descuento se aplica automáticamente en el catálogo mientras la promoción está activa.</p>
    </div>
</header>

@if (Model.Any())
{
    <div class="tabs-estado" role="group" aria-label="Filtrar por estado">
        <button type="button" class="activo" data-estado="">Todas<span>@Model.Count</span></button>
        <button type="button" data-estado="activa">Activas<span>@Contar(EstadoPromocion.Activa)</span></button>
        <button type="button" data-estado="proxima">Próximas<span>@Contar(EstadoPromocion.Proxima)</span></button>
        <button type="button" data-estado="finalizada">Finalizadas<span>@Contar(EstadoPromocion.Finalizada)</span></button>
    </div>

    <div class="promos-grid" id="gridPromos">
        @foreach (var promo in Model)
        {
            <partial name="_PromocionCard" model="promo" />
        }
    </div>
    <div class="vacio" id="sinPromos" hidden><i class="bi bi-calendar-x"></i>No hay promociones en este estado.</div>
}
else
{
    <div class="vacio"><i class="bi bi-percent"></i>Todavía no hay promociones registradas.</div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.tabs-estado button').forEach(boton => {
            boton.addEventListener('click', () => {
                const estado = boton.dataset.estado;
                let visibles = 0;
                document.querySelectorAll('#gridPromos .promo-card').forEach(card => {
                    const mostrar = !estado || card.dataset.estado === estado;
                    card.hidden = !mostrar;
                    if (mostrar) visibles++;
                });
                document.getElementById('sinPromos').hidden = visibles > 0;
                document.querySelectorAll('.tabs-estado button').forEach(b => b.classList.toggle('activo', b === boton));
            });
        });
    </script>
}
