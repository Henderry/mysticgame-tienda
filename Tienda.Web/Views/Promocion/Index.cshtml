@model IEnumerable<Tienda.Application.DTOs.PromocionDTO>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet" />
}
<style>
    /* Estilos básicos del grid */
    .promo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        padding: 20px 0;
    }

    .promo-card {
        background: #0d2a3a;
        border-radius: 10px;
        padding: 20px;
        color: white;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        transition: transform 0.3s ease;
    }

        .promo-card:hover {
            transform: translateY(-5px);
        }

        .promo-card h3 {
            color: #DEDEDF;
            margin-bottom: 10px;
        }

        .promo-card p {
            margin-bottom: 15px;
            color: #c4c4c4;
        }

    .promo-button {
        display: inline-block;
        background: #00abf0;
        color: white;
        padding: 8px 16px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: 500;
    }

    .fecha-container {
        display: flex;
        gap: 5px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

    .fecha-label {
        color: #8a9ba8;
    }

    .fecha-valor {
        color: white;
    }
</style>


<div class="promociones-container">
    <h2 style="font-family:'Poppins', sans-serif; font-size: 1.3rem; color: white; text-transform: uppercase;">Promociones</h2>
    <div class="promo-grid">
        @foreach (var item in Model)
        {
            <div class="promo-card">
                <div style="text-align: center; margin-bottom: 15px;">
                    <i class="ri-discount-percent-line" style="font-size: 2rem; color: #00abf0;"></i>
                </div>
                <h3>@item.Nombre</h3>
                <p><strong>Descuento:</strong> @string.Format("{0:0}%", item.Descuento * 100)</p>
                <div class="fecha-container">
                    <span class="fecha-label">Válido:</span>
                    <span class="fecha-valor">@item.FechaInicio.Value.ToString("dd/MM/yyyy")</span>
                    <span class="fecha-label">-</span>
                    <span class="fecha-valor">@item.FechaFin.Value.ToString("dd/MM/yyyy")</span>
                </div>
                <p>@item.Descripcion</p>
                <a class="promo-button" asp-action="Details" asp-route-id="@item.IdPromocion">Ver Promoción</a>
            </div>

        }
    </div>
</div>
<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th style="color: #DEDEDF">Nombre</th>
            <th style="color: #DEDEDF">Tipo</th>
            <th style="color: #DEDEDF">Inicio</th>
            <th style="color: #DEDEDF">Fin</th>
            <th style="color: #DEDEDF">% Descuento</th>
            <th style="color: #DEDEDF">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var promo in Model)
            {
                <tr>
                    <td style="color: #DEDEDF">@promo.Nombre</td>
                    <td style="color: #DEDEDF">
                        @promo.IdTipoPromocionNavigation?.Tipo
                    </td>
                    <td style="color: #DEDEDF">
                        @promo.FechaInicio?.ToString("yyyy-MM-dd")
                    </td>
                    <td style="color: #DEDEDF">
                        @promo.FechaFin?.ToString("yyyy-MM-dd")
                    </td>
                    <td style="color: #DEDEDF">
                        @($"{promo.Descuento:P0}")
                    </td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@promo.IdPromocion"
                           class="btn btn-sm"
                           style="padding:5px 15px;
                                      background-color:transparent;
                                      border:1px solid #00abf0;
                                      color:white;
                                      border-radius:20px;
                                      box-shadow:0 5px 10px #00abf0;">
                            Editar
                        </a>
                        <a asp-action="Details" asp-route-id="@promo.IdPromocion"
                           class="btn btn-sm ms-1"
                           style="padding:5px 15px;
                                      background-color:transparent;
                                      border:1px solid #2E3E40;
                                      color:white;
                                      border-radius:20px;">
                            Ver
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center" style="color:#DEDEDF">
                    No hay promociones registradas.
                </td>
            </tr>
        }
    </tbody>
</table>