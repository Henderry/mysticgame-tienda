@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<section class="pagina-error">
    <div class="panel text-center mx-auto" style="max-width: 640px">
        <i class="bi bi-exclamation-octagon icono-error"></i>
        <h1>Ocurrió un error</h1>
        <p class="text-secondary">No pudimos procesar tu solicitud. Intenta de nuevo en unos minutos.</p>
        @if (Model?.ShowRequestId == true)
        {
            <div class="detalle-error"><span>Solicitud</span><code>@Model.RequestId</code></div>
        }
        <a class="btn btn-neon mt-4" asp-controller="Home" asp-action="Index">Ir al inicio</a>
    </div>
</section>
