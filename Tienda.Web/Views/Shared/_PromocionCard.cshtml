@model Tienda.Application.DTOs.PromocionDTO
@using Tienda.Web.Models
@using Tienda.Web.Util
@{
    var estado = Model.Estado();
    var dias = Model.DiasRestantes();
    var porcentaje = (int)Math.Round((Model.Descuento ?? 0) * 100);
    var tipo = Model.IdTipoPromocion == 1 ? "Por producto" : "Por categoría";
}
<article class="promo-card promo-@estado.Clase()" data-estado="@estado.Clase()">
    <div class="promo-descuento">
        <strong>@porcentaje<span>%</span></strong>
        <small>de descuento</small>
    </div>
    <div class="promo-cuerpo">
        <div class="d-flex flex-wrap gap-2 mb-2">
            <span class="chip promo-estado">@estado.Texto()</span>
            <span class="chip chip-apagado"><i class="bi @(Model.IdTipoPromocion == 1 ? "bi-box" : "bi-grid")"></i>@tipo</span>
        </div>
        <h3>@Model.Nombre</h3>
        <p>@Model.Descripcion</p>
        <div class="promo-pie">
            <span class="promo-fechas">
                <i class="bi bi-calendar-event"></i>
                @Formato.Fecha(Model.FechaInicio) – @Formato.Fecha(Model.FechaFin)
                @if (estado == EstadoPromocion.Activa && dias != null)
                {
                    <em>@(dias == 0 ? "¡Último día!" : dias == 1 ? "Queda 1 día" : $"Quedan {dias} días")</em>
                }
            </span>
            <a class="btn btn-contorno btn-sm" asp-controller="Promocion" asp-action="Details" asp-route-id="@Model.IdPromocion">Ver productos</a>
        </div>
    </div>
</article>
