@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    string Activo(string c, string? a = null) =>
        string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase)
        && (a == null || string.Equals(accion, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var esMantenimiento = accion is "Crear" or "Editar";
    var titulo = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="MysticGame: tienda de videojuegos, consolas y accesorios con promociones por producto y categoría." />
    <meta name="theme-color" content="#081b29" />
    <title>@(string.IsNullOrEmpty(titulo) ? "MysticGame · Videojuegos, consolas y accesorios" : $"{titulo} · MysticGame")</title>
    <link rel="icon" type="image/png" href="~/img/MysticGame-Logo.ico.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Russo+One&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/styles.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(controlador == "Home" && accion == "Index" ? "pagina-inicio" : "")">
    <a class="visually-hidden-focusable salto" href="#contenido">Saltar al contenido</a>

    <header class="barra-superior" id="barraSuperior">
        <nav class="navbar navbar-expand-lg" aria-label="Navegación principal">
            <div class="container">
                <a class="navbar-brand marca" asp-controller="Home" asp-action="Index" aria-label="MysticGame, inicio">
                    <img src="~/img/MysticGame-Logo.ico.png" alt="" width="56" height="56" />
                    <span class="marca-texto">Mystic<span>Game</span></span>
                </a>

                <div class="d-flex align-items-center gap-2 order-lg-3">
                    <button class="btn-icono position-relative" type="button" data-bs-toggle="offcanvas"
                            data-bs-target="#carrito" aria-controls="carrito" aria-label="Abrir carrito">
                        <i class="bi bi-bag"></i>
                        <span class="contador-carrito" data-carrito-contador hidden>0</span>
                    </button>
                    <button class="navbar-toggler btn-icono" type="button" data-bs-toggle="collapse"
                            data-bs-target="#menuPrincipal" aria-controls="menuPrincipal"
                            aria-expanded="false" aria-label="Abrir menú">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                <div class="collapse navbar-collapse order-lg-2" id="menuPrincipal">
                    <ul class="navbar-nav mx-lg-auto gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @Activo("Home", "Index")" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Producto" && !esMantenimiento || accion == "CategoriaxProducto" ? "active" : "")"
                               asp-controller="Producto" asp-action="Index">Productos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Promocion" && !esMantenimiento ? "active" : "")"
                               asp-controller="Promocion" asp-action="Index">Promociones</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(esMantenimiento ? "active" : "")" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-sliders2 me-1"></i>Administración
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">Mantenimientos</h6></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Producto" asp-action="Crear">
                                        <i class="bi bi-controller me-2"></i>Productos
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Promocion" asp-action="Crear">
                                        <i class="bi bi-percent me-2"></i>Promociones
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido" role="main">
        @if (controlador == "Home" && accion == "Index")
        {
            @RenderBody()
        }
        else
        {
            <div class="container pagina">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="pie">
        <div class="container">
            <div class="row g-4 align-items-start">
                <div class="col-lg-5">
                    <a class="marca mb-3" asp-controller="Home" asp-action="Index">
                        <img src="~/img/MysticGame-Logo.ico.png" alt="" width="48" height="48" />
                        <span class="marca-texto">Mystic<span>Game</span></span>
                    </a>
                    <p class="pie-texto">Videojuegos, consolas y accesorios para todas las plataformas, con promociones que se actualizan cada semana.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h2 class="pie-titulo">Tienda</h2>
                    <ul class="list-unstyled pie-lista">
                        <li><a asp-controller="Producto" asp-action="Index">Productos</a></li>
                        <li><a asp-controller="Promocion" asp-action="Index">Promociones</a></li>
                        <li><a href="#" data-bs-toggle="offcanvas" data-bs-target="#carrito">Mi carrito</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h2 class="pie-titulo">Administración</h2>
                    <ul class="list-unstyled pie-lista">
                        <li><a asp-controller="Producto" asp-action="Crear">Productos</a></li>
                        <li><a asp-controller="Promocion" asp-action="Crear">Promociones</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h2 class="pie-titulo">Tecnología</h2>
                    <p class="pie-texto mb-0">ASP.NET Core 8 MVC · Entity Framework Core · SQL Server · Bootstrap 5</p>
                </div>
            </div>
            <div class="pie-legal">
                <span>© @DateTime.Now.Year MysticGame</span>
                <span>Proyecto académico · Ingeniería del Software, UTN</span>
            </div>
        </div>
    </footer>

    <!-- Carrito (se guarda en el navegador) -->
    <div class="offcanvas offcanvas-end carrito" tabindex="-1" id="carrito" aria-labelledby="carritoTitulo">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title" id="carritoTitulo"><i class="bi bi-bag me-2"></i>Tu carrito</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body">
            <div data-carrito-lista></div>
            <div class="carrito-vacio" data-carrito-vacio>
                <i class="bi bi-controller"></i>
                <p>Tu carrito está vacío.</p>
                <a class="btn btn-neon btn-sm" asp-controller="Producto" asp-action="Index">Explorar productos</a>
            </div>
        </div>
        <div class="offcanvas-footer" data-carrito-resumen hidden>
            <div class="d-flex justify-content-between align-items-baseline mb-3">
                <span class="text-secondary">Total</span>
                <strong class="carrito-total" data-carrito-total>₡0</strong>
            </div>
            <button class="btn btn-neon w-100" type="button" data-carrito-pagar>Finalizar compra</button>
            <button class="btn btn-link btn-sm w-100 text-secondary mt-1" type="button" data-carrito-vaciar>Vaciar carrito</button>
        </div>
    </div>

    <!-- Notificaciones -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="notificaciones">
        @if (TempData["SuccessMessage"] is string exito)
        {
            <div class="toast aviso aviso-exito" role="status" aria-live="polite" data-bs-delay="5000" data-mostrar>
                <div class="toast-body"><i class="bi bi-check-circle-fill"></i><span>@exito</span></div>
            </div>
        }
        @if (TempData["ErrorMessage"] is string fallo)
        {
            <div class="toast aviso aviso-error" role="alert" aria-live="assertive" data-bs-delay="7000" data-mostrar>
                <div class="toast-body"><i class="bi bi-exclamation-triangle-fill"></i><span>@fallo</span></div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scripts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
