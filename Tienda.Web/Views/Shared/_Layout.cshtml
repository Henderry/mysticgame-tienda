<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>MysticGame</title>
    <!-- Favicon-->
    <link rel="icon" type="image/icono.png" href="~/MysticGame-ImageLogo.jpeg">
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="~/css/styles.css" rel="stylesheet" />

    @await RenderSectionAsync("Styles", required: false)
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #081b29;
            background-image: repeating-linear-gradient( to right, transparent 0 100px, #25283b22 100px 101px ), repeating-linear-gradient( to bottom, transparent 0 100px, #25283b22 100px 101px );
            overflow-x: hidden;
        }

            body::before {
                position: absolute;
                width: min(1400px, 90vw);
                top: 10%;
                left: 50%;
                height: 90%;
                transform: translateX(-50%);
                content: '';
                background-size: 100%;
                background-repeat: no-repeat;
                background-position: top center;
                pointer-events: none;
                background-image: none;
                -webkit-mask-image: url(img/bg.png);
                mask-image: url(img/bg.png);
                -webkit-mask-size: 100%;
                mask-size: 100%;
                -webkit-mask-repeat: no-repeat;
                mask-repeat: no-repeat;
                -webkit-mask-position: top center;
                mask-position: top center;
                background-color: #00abf0;
                filter: drop-shadow(0 0 5px #00abf0) drop-shadow(0 0 15px rgba(0, 171, 240, 0.7));
                z-index: 1; /* Asegura que esté detrás del contenido principal */
            }
    </style>
</head>
<body>

    <!-- Navigation-->
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4" style="background: transparent !important; min-height: 80px; padding-top: 0;
    padding-bottom: 0;">
        <div class="container px-4 px-lg-5">
            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")" style="height: 90px; width: auto">
                <img src="~/img/MysticGame-Logo.ico.png" alt="Logo" width="100" height="100" class="me-2" style="height: 120px;width: auto;" />

            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item"><a class="nav-link active" aria-current="page" href="@Url.Action("Index", "Home")" style="color: white !important;">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Producto")" style="color: white !important;">Productos</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Promocion")" style="color: white !important;">Promociones</a></li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false" style="color: white !important;">Mantenimientos</a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="@Url.Action("Crear", "Promocion")">Promociones</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Crear", "Producto")">Productos</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("CrearResena", "Reseñas")">Reseñas</a></li>

                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row text-center text-md-start">

                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3">
                        MysticGame
                    </h5>
                </div>

                <!--Redes sociales -->
                <div class="col-md-4 mb-4">
                    <h6 class="text-uppercase fw-bold mb-3">Síguenos</h6>
                    <a href="#" class="text-white me-3 fs-5"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-white me-3 fs-5"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-white me-3 fs-5"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="text-white fs-5"><i class="bi bi-envelope-fill"></i></a>
                </div>
            </div>

            <hr class="border-secondary" />

            <div class="text-center small text-muted">
                © @DateTime.Now.Year Mi Librería. Todos los derechos reservados.
            </div>
        </div>
    </footer>


    <!-- Bootstrap core JS-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Core theme JS-->
    <script src="~/js/scripts.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>